# Configuración de Servidor Backend - La Palmera POS v23
PORT=4000
NODE_ENV=development

# ===================================================================
# BASE DE DATOS POSTGRESQL ONLINE (RÉPLICA REMOTA Y FUTURO PANEL)
# ===================================================================
# Opción 1: Conexión mediante URI completa (Recomendado para Neon, Supabase, Render, Railway)
# DATABASE_URL=postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/lapalmera_cloud?sslmode=require

# Opción 2: Parámetros individuales (Para servidor dedicado o local)
PGHOST=localhost
PGPORT=5432
PGDATABASE=lapalmera
PGUSER=postgres
PGPASSWORD=postgres
PGMAX=20
PGSSL=false

# ===================================================================
# SEGURIDAD Y AUTENTICACIÓN
# ===================================================================
# Clave Secreta para Autenticación de Sincronización POS Desktop -> API (x-api-key)
API_KEY=tu_api_key_segura_aqui

# En producción, configurar STRICT_AUTH=true para rechazar cualquier petición sin x-api-key o JWT
STRICT_AUTH=false

# JWT Secret para futuros usuarios autenticados de panel web y app móvil
JWT_SECRET=tu_jwt_secret_seguro_aqui

# Contraseñas maestras locales
YASNA_PASSWORD=Carlos1941
KARLA_PASSWORD=Karla2004
VENDEDOR_PASSWORD=Palmera2026
